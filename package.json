{
  "name": "meeting-minutes",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop": "tauri dev",
    "dev:desktop": "tauri dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e:ui": "playwright test",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "eval:meeting": "node scripts/evaluateMeetingRun.mjs",
    "benchmark:text": "node scripts/runTextBenchmark.mjs",
    "benchmark:audio-prepare": "cargo run --manifest-path src-tauri/Cargo.toml --bin audio_prepare_benchmark --",
    "benchmark:chunks": "cargo run --manifest-path src-tauri/Cargo.toml --bin chunk_export_benchmark --",
    "benchmark:cloud-asr": "python scripts\\\\cloud_asr_benchmark.py",
    "setup:transcribe-local": "python -m venv .venv-transcribe && .venv-transcribe\\\\Scripts\\\\python.exe -m pip install --upgrade pip && .venv-transcribe\\\\Scripts\\\\python.exe -m pip install -r scripts\\\\requirements-transcribe-local.txt",
    "benchmark:transcribe-local": ".venv-transcribe\\\\Scripts\\\\python.exe scripts\\\\transcribe_faster_whisper_backend.py",
    "setup:transcribe-parakeet": "python -m venv .venv-parakeet && .venv-parakeet\\\\Scripts\\\\python.exe -m pip install --upgrade pip && .venv-parakeet\\\\Scripts\\\\python.exe -m pip install -r scripts\\\\requirements-transcribe-parakeet.txt",
    "benchmark:transcribe-parakeet": ".venv-parakeet\\\\Scripts\\\\python.exe scripts\\\\transcribe_parakeet_backend.py",
    "setup:diarize-cpu": "python -m venv .venv-diarize && .venv-diarize\\\\Scripts\\\\python.exe -m pip install --upgrade pip && .venv-diarize\\\\Scripts\\\\python.exe -m pip install -r scripts\\\\requirements-diarize-cpu.txt",
    "benchmark:diarize-cpu": ".venv-diarize\\\\Scripts\\\\python.exe scripts\\\\diarize_cpu_backend.py",
    "sidecar:test": "python scripts\\\\meeting_minutes_sidecar_test.py",
    "sidecar:health": "python scripts\\\\meeting_minutes_sidecar.py health",
    "sidecar:serve": "python scripts\\\\meeting_minutes_sidecar.py serve",
    "sidecar:build": "powershell -ExecutionPolicy Bypass -File scripts\\\\build_meeting_minutes_sidecar.ps1",
    "runtime:diarize:stage": "powershell -ExecutionPolicy Bypass -File scripts\\\\stage_diarize_runtime_resource.ps1",
    "runtime:diarize:pack": "powershell -ExecutionPolicy Bypass -File scripts\\\\build_diarize_runtime_pack.ps1",
    "runtime:diarize:install": "powershell -ExecutionPolicy Bypass -File scripts\\\\install_diarize_runtime_pack.ps1",
    "test:runtime-pack": "node scripts/diarizeRuntimePack.test.mjs",
    "compare:diarization": "node scripts/compareDiarizationBenchmarks.mjs",
    "check:pyannote": "powershell -ExecutionPolicy Bypass -File scripts\\\\check_hf_pyannote_access.ps1",
    "setup:pyannote": "python -m venv .venv-pyannote && .venv-pyannote\\\\Scripts\\\\python.exe -m pip install --upgrade pip && .venv-pyannote\\\\Scripts\\\\python.exe -m pip install pyannote.audio",
    "benchmark:pyannote": ".venv-pyannote\\\\Scripts\\\\python.exe scripts\\\\pyannote_community_backend.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
